# ─── Google Calendar (disponibilidad de horarios) ───────────────────────────
# Se usan en api/availability.js. Configúralas en el dashboard de Vercel
# (Project Settings → Environment Variables), NUNCA las subas al repositorio.

# Email de la cuenta de servicio de Google Cloud (termina en .iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Clave privada de la cuenta de servicio (del archivo JSON descargado).
# Pega el valor completo, incluyendo "-----BEGIN PRIVATE KEY-----...-----END PRIVATE KEY-----"
GOOGLE_PRIVATE_KEY=

# ID del calendario de Joy Events a consultar (normalmente el correo: joyeventsrd@gmail.com)
GOOGLE_CALENDAR_ID=joyeventsrd@gmail.com

# ─── Envío de correos (solicitud de llamada) ─────────────────────────────────
# Se usan en api/_lib/mailer.js (Gmail SMTP con Nodemailer).
# GMAIL_USER debe tener verificación en 2 pasos activada, y GMAIL_APP_PASSWORD
# es una "Contraseña de aplicación" generada en myaccount.google.com/apppasswords
# (NO es la contraseña normal de la cuenta).

GMAIL_USER=joyeventsrd@gmail.com
GMAIL_APP_PASSWORD=

# Secreto para firmar los enlaces de "Aceptar/Rechazar" en el correo de solicitud.
# Genera uno único y aleatorio, por ejemplo con: openssl rand -hex 32
REQUEST_TOKEN_SECRET=
